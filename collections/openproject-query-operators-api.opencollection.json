{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenProject API V3 (Stable) Actions & Capabilities Query Operators API",
    "version": "3"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Query Operators",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "View Query Operator",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://qa.openproject-edge.com/api/v3/queries/operators/:id",
            "params": [
              {
                "name": "id",
                "value": "!",
                "type": "path",
                "description": "QueryOperator id"
              }
            ]
          },
          "docs": "Retrieve an individual QueryOperator as identified by the `id` parameter."
        }
      ]
    }
  ],
  "bundled": true
}